# Auto-detect text files and normalize line endings to LF on commit
* text=auto

# Frontend / Root source files (force LF)
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows batch files (force CRLF)
*.cmd text eol=crlf
*.bat text eol=crlf
