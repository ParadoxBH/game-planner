# Saída de build
bin/
obj/

# DLLs dos jogos e do BepInEx: não são nossas, vêm do libs\copy-libs.ps1
libs/**/*.dll

# O .gitignore da raiz ignora *.sln; a solução dos mineradores vai para o repositório
!*.sln

# Saída do extrator offline do Heartopia: textos e inventário do jogo, não vão para o repositório
tools/HeartopiaOffline/out/

# Importador do ARC Raiders: clone do repositório de dados e saída exportada (JSON, imagens, cache de mídia)
tools/ArcRaidersImport/data/
tools/ArcRaidersImport/out/
